{
  "name": "student/flower-shop-management",
  "type": "project",
  "description": "Flower Shop Management System",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "config": {"preferred-install": "dist", "sort-packages": true}
}
